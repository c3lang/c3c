fn void micro_sweep()
{
	char[EXPECTED_MICRO_SWEEP.len] input;
	fill(&input);
	foreach (len, expected : EXPECTED_MICRO_SWEEP)
	{
		check(rapidhash::micro(input[:len], SEED), expected);
	}
}

fn void micro_fold_offset_0()
{
	check(fold(&rapidhash::micro, 0), 0x97c278686e8fcaf0);
}

fn void micro_fold_offset_3()
{
	check(fold(&rapidhash::micro, 3), 0x9546b977a643a429);
}

fn void micro_fold_offset_6()
{
	check(fold(&rapidhash::micro, 6), 0x2dd55a1e4708d8fe);
}


fn void nano_strings()
{
	check(rapidhash::nano(""), 0x0338dc4be2cecdae);
	check(rapidhash::nano("a"), 0x599f47df33a2e1eb);
	check(rapidhash::nano("abc"), 0xcb475beafa9c0da2);
	check(rapidhash::nano("7 chars"), 0xdc5a65a9cc146b87);
	check(rapidhash::nano("This is a test of rapidhash."), 0x4c4625e0e4071f3a);
	check(rapidhash::nano("", SEED), 0xf7d2b22322bb74e2);
	check(rapidhash::nano("a", SEED), 0x7ec7a935271e7108);
	check(rapidhash::nano("abc", SEED), 0x28da433c16bfd579);
	check(rapidhash::nano("7 chars", SEED), 0x58df9a3a11fb9275);
	check(rapidhash::nano("This is a test of rapidhash.", SEED), 0xb31fb5d5d2939ff9);
}

