fn void hash_sweep()
{
	char[EXPECTED_HASH_SWEEP.len] input;
	fill(&input);
	foreach (len, expected : EXPECTED_HASH_SWEEP)
	{
		check(rapidhash::hash(input[:len], SEED), expected);
	}
}

fn void hash_fold_offset_0()
{
	check(fold(&rapidhash::hash, 0), 0x883867303a60946b);
}

fn void hash_fold_offset_3()
{
	check(fold(&rapidhash::hash, 3), 0xfc52bafee3502c03);
}

fn void hash_fold_offset_6()
{
	check(fold(&rapidhash::hash, 6), 0xb70ce6efbeda7cc3);
}


fn void micro_strings()
{
	check(rapidhash::micro(""), 0x0338dc4be2cecdae);
	check(rapidhash::micro("a"), 0x599f47df33a2e1eb);
	check(rapidhash::micro("abc"), 0xcb475beafa9c0da2);
	check(rapidhash::micro("7 chars"), 0xdc5a65a9cc146b87);
	check(rapidhash::micro("This is a test of rapidhash."), 0x4c4625e0e4071f3a);
	check(rapidhash::micro("", SEED), 0xf7d2b22322bb74e2);
	check(rapidhash::micro("a", SEED), 0x7ec7a935271e7108);
	check(rapidhash::micro("abc", SEED), 0x28da433c16bfd579);
	check(rapidhash::micro("7 chars", SEED), 0x58df9a3a11fb9275);
	check(rapidhash::micro("This is a test of rapidhash.", SEED), 0xb31fb5d5d2939ff9);
}

