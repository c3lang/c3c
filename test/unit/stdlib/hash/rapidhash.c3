module rapidhash_tests @test;

import std::hash::rapidhash;


const ulong SEED = 0x12ca6b4391e055fe;
const usz FOLD_LEN = 2048;
const ulong FOLD_PRIME = 0x100000001b3;

alias HashFn = fn ulong(char[], ulong);

macro void check(ulong actual, ulong expected) @local
{
	test::@check(actual == expected, "Hash mismatch (%x expected // %x actual).", expected, actual);
}

// Bytes which do not repeat over short distances, so that a wrong read offset changes the result.
macro void fill(char[] buf) @local
{
	foreach (i, &c : buf) *c = (char)(i * 31 + 7);
}

// Hash every length up to FOLD_LEN, starting at offset, and combine the results in order.
macro ulong fold(HashFn hash_fn, usz offset) @local
{
	char[FOLD_LEN + 16] buf;
	fill(&buf);
	ulong acc = 0;
	for (usz len = 0; len <= FOLD_LEN; len++)
	{
		acc = (acc ^ hash_fn(buf[offset:len], SEED)) * FOLD_PRIME;
	}
	return acc;
}


fn void hash_strings()
{
	check(rapidhash::hash(""), 0x0338dc4be2cecdae);
	check(rapidhash::hash("a"), 0x599f47df33a2e1eb);
	check(rapidhash::hash("abc"), 0xcb475beafa9c0da2);
	check(rapidhash::hash("7 chars"), 0xdc5a65a9cc146b87);
	check(rapidhash::hash("This is a test of rapidhash."), 0x4c4625e0e4071f3a);
	check(rapidhash::hash("", SEED), 0xf7d2b22322bb74e2);
	check(rapidhash::hash("a", SEED), 0x7ec7a935271e7108);
	check(rapidhash::hash("abc", SEED), 0x28da433c16bfd579);
	check(rapidhash::hash("7 chars", SEED), 0x58df9a3a11fb9275);
	check(rapidhash::hash("This is a test of rapidhash.", SEED), 0xb31fb5d5d2939ff9);
}

