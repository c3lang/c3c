module std::math::nolibc::pow_test @test @feat(NO_LIBC, C3_MATH);
import std::math::nolibc;
// c3c compile-test test/unit/stdlib/math/math_nolibc_pow.c3 -D C3_MATH

struct DoubleCase { ulong x; ulong y; ulong expected; }
struct FloatCase { uint x; uint y; uint expected; }

// Bit patterns { x, y, pow(x, y) }. Expected values come from musl's pow and powf
// (generic non-FMA build) and were cross-checked against the macOS libm, which agrees
// on every case. A NaN expectation is written as the default NaN; only NaN-ness is checked.
const DoubleCase[*] DOUBLE_CASES = {
	// pow(x, +-0) = 1 for any x, even NaN.
	{ 0x7ff8000000000000, 0x0000000000000000, 0x3ff0000000000000 }, // pow(NaN, +0)
	{ 0x7ff8000000000000, 0x8000000000000000, 0x3ff0000000000000 }, // pow(NaN, -0)
	{ 0xfff0000000000000, 0x0000000000000000, 0x3ff0000000000000 }, // pow(-inf, +0)
	{ 0x0000000000000000, 0x8000000000000000, 0x3ff0000000000000 }, // pow(+0, -0)
	{ 0xc008000000000000, 0x0000000000000000, 0x3ff0000000000000 }, // pow(-3, +0)
	// pow(+1, y) = 1 for any y, even NaN.
	{ 0x3ff0000000000000, 0x7ff8000000000000, 0x3ff0000000000000 }, // pow(1, NaN)
	{ 0x3ff0000000000000, 0x7ff0000000000000, 0x3ff0000000000000 }, // pow(1, inf)
	{ 0x3ff0000000000000, 0xfff0000000000000, 0x3ff0000000000000 }, // pow(1, -inf)
	{ 0x3ff0000000000000, 0xc00c000000000000, 0x3ff0000000000000 }, // pow(1, -3.5)
	{ 0x3ff0000000000000, 0x4450000000000000, 0x3ff0000000000000 }, // pow(1, 2^70)
	// pow(-1, +-inf) = 1.
	{ 0xbff0000000000000, 0x7ff0000000000000, 0x3ff0000000000000 }, // pow(-1, inf)
	{ 0xbff0000000000000, 0xfff0000000000000, 0x3ff0000000000000 }, // pow(-1, -inf)
	// pow(+-0, y).
	{ 0x0000000000000000, 0xc008000000000000, 0x7ff0000000000000 }, // pow(+0, -3) = +inf
	{ 0x8000000000000000, 0xc008000000000000, 0xfff0000000000000 }, // pow(-0, -3) = -inf
	{ 0x0000000000000000, 0xc000000000000000, 0x7ff0000000000000 }, // pow(+0, -2) = +inf
	{ 0x8000000000000000, 0xc000000000000000, 0x7ff0000000000000 }, // pow(-0, -2) = +inf
	{ 0x8000000000000000, 0xbfe0000000000000, 0x7ff0000000000000 }, // pow(-0, -0.5) = +inf
	{ 0x0000000000000000, 0xfff0000000000000, 0x7ff0000000000000 }, // pow(+0, -inf) = +inf
	{ 0x8000000000000000, 0xfff0000000000000, 0x7ff0000000000000 }, // pow(-0, -inf) = +inf
	{ 0x0000000000000000, 0x4008000000000000, 0x0000000000000000 }, // pow(+0, 3) = +0
	{ 0x8000000000000000, 0x4008000000000000, 0x8000000000000000 }, // pow(-0, 3) = -0
	{ 0x8000000000000000, 0x4000000000000000, 0x0000000000000000 }, // pow(-0, 2) = +0
	{ 0x8000000000000000, 0x3fe0000000000000, 0x0000000000000000 }, // pow(-0, 0.5) = +0
	{ 0x8000000000000000, 0x7ff0000000000000, 0x0000000000000000 }, // pow(-0, inf) = +0
	// |x| < 1 and |x| > 1 with infinite y.
	{ 0x3fe0000000000000, 0x7ff0000000000000, 0x0000000000000000 }, // pow(0.5, inf) = +0
	{ 0x3fe0000000000000, 0xfff0000000000000, 0x7ff0000000000000 }, // pow(0.5, -inf) = +inf
	{ 0xbfe0000000000000, 0x7ff0000000000000, 0x0000000000000000 }, // pow(-0.5, inf) = +0
	{ 0xbfe0000000000000, 0xfff0000000000000, 0x7ff0000000000000 }, // pow(-0.5, -inf) = +inf
	{ 0x4000000000000000, 0x7ff0000000000000, 0x7ff0000000000000 }, // pow(2, inf) = +inf
	{ 0x4000000000000000, 0xfff0000000000000, 0x0000000000000000 }, // pow(2, -inf) = +0
	{ 0xc000000000000000, 0x7ff0000000000000, 0x7ff0000000000000 }, // pow(-2, inf) = +inf
	{ 0xc000000000000000, 0xfff0000000000000, 0x0000000000000000 }, // pow(-2, -inf) = +0
	{ 0x3fefffffffffffff, 0x7ff0000000000000, 0x0000000000000000 }, // pow(1-2^-53, inf) = +0
	{ 0x3ff0000000000001, 0xfff0000000000000, 0x0000000000000000 }, // pow(1+2^-52, -inf) = +0
	// Infinite x.
	{ 0xfff0000000000000, 0xc008000000000000, 0x8000000000000000 }, // pow(-inf, -3) = -0
	{ 0xfff0000000000000, 0xc000000000000000, 0x0000000000000000 }, // pow(-inf, -2) = +0
	{ 0xfff0000000000000, 0xbfe0000000000000, 0x0000000000000000 }, // pow(-inf, -0.5) = +0
	{ 0xfff0000000000000, 0x4008000000000000, 0xfff0000000000000 }, // pow(-inf, 3) = -inf
	{ 0xfff0000000000000, 0x4000000000000000, 0x7ff0000000000000 }, // pow(-inf, 2) = +inf
	{ 0xfff0000000000000, 0x3fe0000000000000, 0x7ff0000000000000 }, // pow(-inf, 0.5) = +inf
	{ 0x7ff0000000000000, 0xbfe0000000000000, 0x0000000000000000 }, // pow(inf, -0.5) = +0
	{ 0x7ff0000000000000, 0x3af0000000000000, 0x7ff0000000000000 }, // pow(inf, 2^-80) = +inf
	{ 0x7ff0000000000000, 0xfff0000000000000, 0x0000000000000000 }, // pow(inf, -inf) = +0
	{ 0x7ff0000000000000, 0x7ff0000000000000, 0x7ff0000000000000 }, // pow(inf, inf) = +inf
	// Negative finite x with non-integer y is NaN; NaN propagates.
	{ 0xc000000000000000, 0x3fe0000000000000, 0x7ff8000000000000 }, // pow(-2, 0.5) = NaN
	{ 0xbff0000000000000, 0x3ff8000000000000, 0x7ff8000000000000 }, // pow(-1, 1.5) = NaN
	{ 0xc020000000000000, 0x3fd5555555555555, 0x7ff8000000000000 }, // pow(-8, 1/3) = NaN
	{ 0x8000000000000001, 0x3fe0000000000000, 0x7ff8000000000000 }, // pow(-min subnormal, 0.5) = NaN
	{ 0x7ff8000000000000, 0x3ff0000000000000, 0x7ff8000000000000 }, // pow(NaN, 1)
	{ 0x4000000000000000, 0x7ff8000000000000, 0x7ff8000000000000 }, // pow(2, NaN)
	{ 0x7ff8000000000000, 0x7ff8000000000000, 0x7ff8000000000000 }, // pow(NaN, NaN)
	{ 0xbff0000000000000, 0x7ff8000000000000, 0x7ff8000000000000 }, // pow(-1, NaN)
	{ 0x7ff8000000000000, 0xfff0000000000000, 0x7ff8000000000000 }, // pow(NaN, -inf)
	// Large integer y: parity decides the sign.
	{ 0xbff0000000000000, 0x41e0000000200000, 0xbff0000000000000 }, // pow(-1, 2^31+1) = -1
	{ 0xbff0000000000000, 0xc1e0000000200000, 0xbff0000000000000 }, // pow(-1, -(2^31+1)) = -1
	{ 0xbff0000000000000, 0x41f0000000000000, 0x3ff0000000000000 }, // pow(-1, 2^32) = 1
	{ 0xbff0000000000000, 0x4330000000000001, 0xbff0000000000000 }, // pow(-1, 2^52+1) = -1
	{ 0xbff0000000000000, 0xc330000000000001, 0xbff0000000000000 }, // pow(-1, -(2^52+1)) = -1
	{ 0xbff0000000000000, 0x4340000000000000, 0x3ff0000000000000 }, // pow(-1, 2^53) = 1
	{ 0xbff0000000000000, 0x4340000000000001, 0x3ff0000000000000 }, // pow(-1, 2^53+2) = 1
	{ 0xbff0000000000000, 0x43e0000000000000, 0x3ff0000000000000 }, // pow(-1, 2^63) = 1
	{ 0xbff0000000000000, 0x7e37e43c8800759c, 0x3ff0000000000000 }, // pow(-1, 1e300) = 1
	{ 0x8000000000000000, 0x4330000000000001, 0x8000000000000000 }, // pow(-0, 2^52+1) = -0
	{ 0x8000000000000000, 0xc330000000000001, 0xfff0000000000000 }, // pow(-0, -(2^52+1)) = -inf
	{ 0x8000000000000000, 0x4340000000000000, 0x0000000000000000 }, // pow(-0, 2^53) = +0
	{ 0x8000000000000000, 0xc340000000000000, 0x7ff0000000000000 }, // pow(-0, -2^53) = +inf
	{ 0xfff0000000000000, 0x4330000000000001, 0xfff0000000000000 }, // pow(-inf, 2^52+1) = -inf
	{ 0xfff0000000000000, 0x4340000000000000, 0x7ff0000000000000 }, // pow(-inf, 2^53) = +inf
	{ 0xfff0000000000000, 0xc1e0000000200000, 0x8000000000000000 }, // pow(-inf, -(2^31+1)) = -0
	{ 0xbff0000000000001, 0x41e0000000200000, 0xbff0000080000201 }, // pow(-(1+2^-52), 2^31+1)
	{ 0xbfefffffffffffff, 0x4330000000000001, 0xbfe368b2fc6f9609 }, // pow(-(1-2^-53), 2^52+1)
	{ 0xbff0000000000001, 0x4340000000000000, 0x401d8e64b8d4ddac }, // pow(-(1+2^-52), 2^53)
	{ 0xc000000000000000, 0x41e0000000200000, 0xfff0000000000000 }, // pow(-2, 2^31+1) = -inf
	{ 0xbfe0000000000000, 0x41e0000000200000, 0x8000000000000000 }, // pow(-0.5, 2^31+1) = -0
	// Huge and tiny |y|.
	{ 0x4000000000000000, 0x7e37e43c8800759c, 0x7ff0000000000000 }, // pow(2, 1e300) = inf
	{ 0x4000000000000000, 0xfe37e43c8800759c, 0x0000000000000000 }, // pow(2, -1e300) = 0
	{ 0x3fe0000000000000, 0x7e37e43c8800759c, 0x0000000000000000 }, // pow(0.5, 1e300) = 0
	{ 0xc000000000000000, 0x7e37e43c8800759c, 0x7ff0000000000000 }, // pow(-2, 1e300) = inf
	{ 0x3ff0000000000001, 0x43e0000000000000, 0x7ff0000000000000 }, // pow(1+2^-52, 2^63) = inf
	{ 0x3fefffffffffffff, 0x43f0000000000000, 0x0000000000000000 }, // pow(1-2^-53, 2^64) = 0
	{ 0x3ff0000000000001, 0x43d0000000000000, 0x7ff0000000000000 }, // pow(1+2^-52, 2^62)
	{ 0x3fefffffffffffff, 0xc3d0000000000000, 0x6e19476504ba85f9 }, // pow(1-2^-53, -2^62)
	{ 0x4000000000000000, 0x3bc79ca10c924223, 0x3ff0000000000000 }, // pow(2, 1e-20)
	{ 0x3fe0000000000000, 0x3bc79ca10c924223, 0x3ff0000000000000 }, // pow(0.5, 1e-20)
	{ 0x7e37e43c8800759c, 0x3b90000000000000, 0x3ff0000000000000 }, // pow(1e300, 2^-70)
	{ 0x01a56e1fc2f8f359, 0xbb90000000000000, 0x3ff0000000000000 }, // pow(1e-300, -2^-70)
	// Overflow, both signs.
	{ 0x4000000000000000, 0x4090000000000000, 0x7ff0000000000000 }, // pow(2, 1024) = inf
	{ 0xc000000000000000, 0x4090040000000000, 0xfff0000000000000 }, // pow(-2, 1025) = -inf
	{ 0xc000000000000000, 0x4090000000000000, 0x7ff0000000000000 }, // pow(-2, 1024) = inf
	{ 0x4024000000000000, 0x4073500000000000, 0x7ff0000000000000 }, // pow(10, 309) = inf
	{ 0x7e37e43c8800759c, 0x4000000000000000, 0x7ff0000000000000 }, // pow(1e300, 2) = inf
	{ 0xfe37e43c8800759c, 0x4008000000000000, 0xfff0000000000000 }, // pow(-1e300, 3) = -inf
	{ 0x3ff8000000000000, 0x409f400000000000, 0x7ff0000000000000 }, // pow(1.5, 2000) = inf
	{ 0x0000000000000001, 0xbff0000000000000, 0x7ff0000000000000 }, // pow(min subnormal, -1) = inf
	{ 0x4000000000000000, 0x408fffffffffffff, 0x7feffffffffffd3a }, // pow(2, 1024-2^-43)
	{ 0x7fefffffffffffff, 0x3ff0000000000000, 0x7fefffffffffffff }, // pow(DBL_MAX, 1) = DBL_MAX
	// Underflow, both signs.
	{ 0x4000000000000000, 0xc090e00000000000, 0x0000000000000000 }, // pow(2, -1080) = 0
	{ 0xc000000000000000, 0xc090e40000000000, 0x8000000000000000 }, // pow(-2, -1081) = -0
	{ 0x3ff8000000000000, 0xc09f400000000000, 0x0000000000000000 }, // pow(1.5, -2000) = 0
	{ 0x3fe0000000000000, 0x4090cc0000000000, 0x0000000000000000 }, // pow(0.5, 1075) = 0
	{ 0x01a56e1fc2f8f359, 0x4000000000000000, 0x0000000000000000 }, // pow(1e-300, 2) = 0
	{ 0x81a56e1fc2f8f359, 0x4008000000000000, 0x8000000000000000 }, // pow(-1e-300, 3) = -0
	{ 0x4000000000000000, 0xc090cc0000000000, 0x0000000000000000 }, // pow(2, -1075) = 0 (tie)
	{ 0xc000000000000000, 0xc090cc0000000000, 0x8000000000000000 }, // pow(-2, -1075) = -0 (tie)
	// Subnormal results.
	{ 0x4000000000000000, 0xc090c80000000000, 0x0000000000000001 }, // pow(2, -1074) = min subnormal
	{ 0xc000000000000000, 0xc090c40000000000, 0x8000000000000002 }, // pow(-2, -1073)
	{ 0x4000000000000000, 0xc090180000000000, 0x0000100000000000 }, // pow(2, -1030)
	{ 0x1e60000000000000, 0x4000000000000000, 0x0000000000000001 }, // pow(2^-537, 2)
	{ 0x1eb67e9c127b6e74, 0x4000000000000000, 0x00000000000007e8 }, // pow(1e-160, 2)
	{ 0x4008000000000000, 0xc084f00000000000, 0x00000000000010db }, // pow(3, -670)
	{ 0x4024000000000000, 0xc073600000000000, 0x000012688b70e62b }, // pow(10, -310)
	{ 0xc024000000000000, 0xc073b00000000000, 0x800000000c1069cd }, // pow(-10, -315)
	{ 0x4000000000000000, 0xc090c60000000000, 0x0000000000000001 }, // pow(2, -1073.5)
	{ 0x3fe8000000000000, 0x40a3610000000000, 0x0000169e8b1fbfe4 }, // pow(0.75, 2480.5)
	{ 0x4000000000000000, 0xc08ff40000000000, 0x000b504f333f9de6 }, // pow(2, -1022.5)
	// Subnormal x.
	{ 0x0000000000000001, 0x3fe0000000000000, 0x1e60000000000000 }, // pow(min subnormal, 0.5)
	{ 0x0008000000000000, 0x3fe0000000000000, 0x1ff6a09e667f3bcd }, // pow(2^-1023, 0.5)
	{ 0x8000000000000001, 0x4008000000000000, 0x8000000000000000 }, // pow(-min subnormal, 3) = -0
	{ 0x0000000001230000, 0x3fb999999999999a, 0x396034d3870c765a }, // pow(subnormal, 0.1)
	{ 0x000fffffffffffff, 0xbfd0000000000000, 0x4fe6a09e667f3bcd }, // pow(max subnormal, -0.25)
	{ 0x8001234567890000, 0xbff0000000000000, 0xfff0000000000000 }, // pow(-subnormal, -1)
	{ 0x0000000000000001, 0x3f50624dd2f1a9fc, 0x3fde666733f452da }, // pow(min subnormal, 0.001)
	// Typical values.
	{ 0x4000000000000000, 0x3fe0000000000000, 0x3ff6a09e667f3bcd }, // sqrt(2)
	{ 0x4000000000000000, 0x4024000000000000, 0x4090000000000000 }, // 1024
	{ 0x4024000000000000, 0xc000000000000000, 0x3f847ae147ae147b }, // 0.01
	{ 0x400c000000000000, 0x4002000000000000, 0x4030c15d985a90f4 },
	{ 0x400921fb54442d18, 0x4005bf0a8b145769, 0x4036758b5c381110 }, // pi^e
	{ 0x4005bf0a8b145769, 0x400921fb54442d18, 0x403724046eb09338 }, // e^pi
	{ 0x3fb999999999999a, 0x4008000000000000, 0x3f50624dd2f1a9fd },
	{ 0xc008000000000000, 0x4008000000000000, 0xc03b000000000000 }, // -27
	{ 0xc008000000000000, 0xc008000000000000, 0xbfa2f684bda12f68 }, // -1/27
	{ 0xc004000000000000, 0x4010000000000000, 0x4043880000000000 },
	{ 0x3ff000001ad7f29b, 0x416312d000000000, 0x4005bf0a790ce6f2 },
	{ 0x3feff7ced916872b, 0x40f86a0000000000, 0x36e940747bb85395 },
	{ 0x401c000000000000, 0x3fd5555555555555, 0x3ffe9b5dba58189d },
	{ 0x4202a05f20000000, 0x3fb999999999999a, 0x4024000000000001 },
	{ 0x405edd2f1a9fbe77, 0xc01f8f5c28f5c28f, 0x3c8224ec1169f129 },
	{ 0x4000000000000000, 0x3fb999999999999a, 0x3ff125fbee250664 },
	{ 0x4059000000000000, 0x3ff8000000000000, 0x408f400000000000 }, // 1000
	{ 0xbff8000000000000, 0x4035000000000000, 0xc0b37be295980000 },
	{ 0x3fe0000000000000, 0xbfe0000000000000, 0x3ff6a09e667f3bcd },
	{ 0x3ee4f8b588e368f1, 0x3fd3333333333333, 0x3fa030dc4ea03a73 },
	{ 0x4039000000000000, 0x3fe0000000000000, 0x4014000000000000 }, // 5
	{ 0x4020000000000000, 0x3fd5555555555555, 0x4000000000000000 },
	{ 0x3ff3c0ca428c59fb, 0x405edd2f1a9fbe77, 0x42472004fc181028 },
	{ 0x3ff6a09e667f3bcd, 0x4000000000000000, 0x4000000000000001 },
	{ 0x3feffffffff24190, 0xc202a05f20000000, 0x4005bf0aa948eac6 },
};

const FloatCase[*] FLOAT_CASES = {
	// pow(x, +-0) = 1 for any x, even NaN.
	{ 0x7fc00000, 0x00000000, 0x3f800000 }, // powf(NaN, +0)
	{ 0x7fc00000, 0x80000000, 0x3f800000 }, // powf(NaN, -0)
	{ 0xff800000, 0x00000000, 0x3f800000 }, // powf(-inf, +0)
	{ 0x00000000, 0x80000000, 0x3f800000 }, // powf(+0, -0)
	// pow(+1, y) = 1 for any y, even NaN.
	{ 0x3f800000, 0x7fc00000, 0x3f800000 }, // powf(1, NaN)
	{ 0x3f800000, 0x7f800000, 0x3f800000 }, // powf(1, inf)
	{ 0x3f800000, 0xff800000, 0x3f800000 }, // powf(1, -inf)
	{ 0x3f800000, 0xc0600000, 0x3f800000 }, // powf(1, -3.5)
	// pow(-1, +-inf) = 1.
	{ 0xbf800000, 0x7f800000, 0x3f800000 }, // powf(-1, inf)
	{ 0xbf800000, 0xff800000, 0x3f800000 }, // powf(-1, -inf)
	// pow(+-0, y).
	{ 0x00000000, 0xc0400000, 0x7f800000 }, // powf(+0, -3) = +inf
	{ 0x80000000, 0xc0400000, 0xff800000 }, // powf(-0, -3) = -inf
	{ 0x80000000, 0xc0000000, 0x7f800000 }, // powf(-0, -2) = +inf
	{ 0x80000000, 0xbf000000, 0x7f800000 }, // powf(-0, -0.5) = +inf
	{ 0x80000000, 0xff800000, 0x7f800000 }, // powf(-0, -inf) = +inf
	{ 0x00000000, 0x40400000, 0x00000000 }, // powf(+0, 3) = +0
	{ 0x80000000, 0x40400000, 0x80000000 }, // powf(-0, 3) = -0
	{ 0x80000000, 0x40000000, 0x00000000 }, // powf(-0, 2) = +0
	{ 0x80000000, 0x3f000000, 0x00000000 }, // powf(-0, 0.5) = +0
	{ 0x80000000, 0x7f800000, 0x00000000 }, // powf(-0, inf) = +0
	// |x| < 1 and |x| > 1 with infinite y.
	{ 0x3f000000, 0x7f800000, 0x00000000 }, // powf(0.5, inf) = +0
	{ 0x3f000000, 0xff800000, 0x7f800000 }, // powf(0.5, -inf) = +inf
	{ 0xbf000000, 0x7f800000, 0x00000000 }, // powf(-0.5, inf) = +0
	{ 0xbf000000, 0xff800000, 0x7f800000 }, // powf(-0.5, -inf) = +inf
	{ 0x40000000, 0x7f800000, 0x7f800000 }, // powf(2, inf) = +inf
	{ 0x40000000, 0xff800000, 0x00000000 }, // powf(2, -inf) = +0
	{ 0xc0000000, 0x7f800000, 0x7f800000 }, // powf(-2, inf) = +inf
	{ 0xc0000000, 0xff800000, 0x00000000 }, // powf(-2, -inf) = +0
	// Infinite x.
	{ 0xff800000, 0xc0400000, 0x80000000 }, // powf(-inf, -3) = -0
	{ 0xff800000, 0xc0000000, 0x00000000 }, // powf(-inf, -2) = +0
	{ 0xff800000, 0x40400000, 0xff800000 }, // powf(-inf, 3) = -inf
	{ 0xff800000, 0x40000000, 0x7f800000 }, // powf(-inf, 2) = +inf
	{ 0xff800000, 0x3f000000, 0x7f800000 }, // powf(-inf, 0.5) = +inf
	{ 0x7f800000, 0xbf000000, 0x00000000 }, // powf(inf, -0.5) = +0
	{ 0x7f800000, 0x3f000000, 0x7f800000 }, // powf(inf, 0.5) = +inf
	// Negative finite x with non-integer y is NaN; NaN propagates.
	{ 0xc0000000, 0x3f000000, 0x7fc00000 }, // powf(-2, 0.5) = NaN
	{ 0xbf800000, 0x3fc00000, 0x7fc00000 }, // powf(-1, 1.5) = NaN
	{ 0x7fc00000, 0x3f800000, 0x7fc00000 }, // powf(NaN, 1)
	{ 0x40000000, 0x7fc00000, 0x7fc00000 }, // powf(2, NaN)
	{ 0xbf800000, 0x7fc00000, 0x7fc00000 }, // powf(-1, NaN)
	// Large integer y: parity decides the sign.
	{ 0xbf800000, 0x4b7fffff, 0xbf800000 }, // powf(-1, 2^24-1) = -1
	{ 0xbf800000, 0xcb7fffff, 0xbf800000 }, // powf(-1, -(2^24-1)) = -1
	{ 0xbf800000, 0x4b800000, 0x3f800000 }, // powf(-1, 2^24) = 1
	{ 0xbf800000, 0x4f000000, 0x3f800000 }, // powf(-1, 2^31) = 1
	{ 0xbf800000, 0x71800000, 0x3f800000 }, // powf(-1, 2^100) = 1
	{ 0x80000000, 0x4b7fffff, 0x80000000 }, // powf(-0, 2^24-1) = -0
	{ 0x80000000, 0xcb7fffff, 0xff800000 }, // powf(-0, -(2^24-1)) = -inf
	{ 0xff800000, 0x4b7fffff, 0xff800000 }, // powf(-inf, 2^24-1) = -inf
	{ 0xff800000, 0x4b800000, 0x7f800000 }, // powf(-inf, 2^24) = +inf
	{ 0xbf800001, 0x4b7fffff, 0xc0ec7322 }, // powf(-(1+2^-23), 2^24-1)
	{ 0xc0000000, 0x4b7fffff, 0xff800000 }, // powf(-2, 2^24-1) = -inf
	{ 0x40000000, 0x71800000, 0x7f800000 }, // powf(2, 2^100) = inf
	{ 0x3f000000, 0x71800000, 0x00000000 }, // powf(0.5, 2^100) = 0
	// Overflow, both signs.
	{ 0x40000000, 0x43000000, 0x7f800000 }, // powf(2, 128) = inf
	{ 0xc0000000, 0x43010000, 0xff800000 }, // powf(-2, 129) = -inf
	{ 0xc0000000, 0x43000000, 0x7f800000 }, // powf(-2, 128) = inf
	{ 0x41200000, 0x421c0000, 0x7f800000 }, // powf(10, 39) = inf
	{ 0x00000001, 0xbf800000, 0x7f800000 }, // powf(min subnormal, -1) = inf
	{ 0x40000000, 0x42ffffff, 0x7f7fffa7 }, // powf(2, 128-2^-17)
	{ 0x7f7fffff, 0x3f800000, 0x7f7fffff }, // powf(FLT_MAX, 1)
	// Underflow, both signs.
	{ 0x40000000, 0xc3170000, 0x00000000 }, // powf(2, -151) = 0
	{ 0xc0000000, 0xc3170000, 0x80000000 }, // powf(-2, -151) = -0
	{ 0x40000000, 0xc3160000, 0x00000000 }, // powf(2, -150) = 0 (tie)
	{ 0x41200000, 0xc2480000, 0x00000000 }, // powf(10, -50) = 0
	// Subnormal results.
	{ 0x40000000, 0xc3150000, 0x00000001 }, // powf(2, -149) = min subnormal
	{ 0xc0000000, 0xc3150000, 0x80000001 }, // powf(-2, -149) = -min subnormal
	{ 0x40000000, 0xc3020000, 0x00080000 }, // powf(2, -130)
	{ 0x40000000, 0xc2fd0000, 0x005a827a }, // powf(2, -126.5)
	{ 0x41200000, 0xc2200000, 0x000116c2 }, // powf(10, -40)
	{ 0x40400000, 0xc2ab0000, 0x00002ccf }, // powf(3, -85.5)
	// Subnormal x.
	{ 0x00000001, 0x3f000000, 0x1a3504f3 }, // powf(min subnormal, 0.5)
	{ 0x80000001, 0x3f800000, 0x80000001 }, // powf(-min subnormal, 1)
	{ 0x00000246, 0x3e800000, 0x2e042ac4 }, // powf(subnormal, 0.25)
	{ 0x80006000, 0xbf800000, 0xff800000 }, // powf(-subnormal, -1)
	{ 0x00000001, 0x3c23d70a, 0x3eb64747 }, // powf(min subnormal, 0.01)
	// Typical values.
	{ 0x40000000, 0x3f000000, 0x3fb504f3 }, // sqrt(2)
	{ 0x40000000, 0x41200000, 0x44800000 }, // 1024
	{ 0x41200000, 0xc0000000, 0x3c23d70a }, // 0.01
	{ 0x40600000, 0x40100000, 0x41860aed },
	{ 0x40490fdb, 0x402df854, 0x41b3ac5b }, // pi^e
	{ 0x3dcccccd, 0x40400000, 0x3a83126f },
	{ 0xc0400000, 0x40400000, 0xc1d80000 }, // -27
	{ 0xc0400000, 0xc0400000, 0xbd17b426 },
	{ 0x3f800347, 0x461c4000, 0x402dfd7e },
	{ 0x3f7fbe77, 0x459c4000, 0x3bdc4068 },
	{ 0x40e00000, 0x3eaaaa9f, 0x3ff4dae3 },
	{ 0x42f6e979, 0xc0fc7ae1, 0x24112766 },
	{ 0x42c80000, 0x3fc00000, 0x447a0000 }, // 1000
	{ 0xbfc00000, 0x41a80000, 0xc59bdf15 },
	{ 0x3727c5ac, 0x3e99999a, 0x3d0186e1 },
	{ 0x41c80000, 0x3f000000, 0x40a00000 }, // 5
	{ 0x3f9e0651, 0x41458794, 0x4157bcf0 },
};

fn void pow_matches_musl()
{
	foreach (c : DOUBLE_CASES)
	{
		ulong x = c.x;
		ulong y = c.y;
		double r = nolibc::pow(bitcast(@volatile_load(x), double), bitcast(@volatile_load(y), double));
		ulong got = bitcast(r, ulong);
		if (math::is_nan(bitcast(c.expected, double)))
		{
			assert(math::is_nan(r), "pow(%a, %a) = %a, expected NaN", bitcast(c.x, double), bitcast(c.y, double), r);
			continue;
		}
		assert(got == c.expected, "pow(%a, %a) = %a (%x), expected %a (%x)",
			bitcast(c.x, double), bitcast(c.y, double), r, got, bitcast(c.expected, double), c.expected);
	}
}

fn void powf_matches_musl()
{
	foreach (c : FLOAT_CASES)
	{
		uint x = c.x;
		uint y = c.y;
		float r = nolibc::powf(bitcast(@volatile_load(x), float), bitcast(@volatile_load(y), float));
		uint got = bitcast(r, uint);
		if (math::is_nan(bitcast(c.expected, float)))
		{
			assert(math::is_nan(r), "powf(%a, %a) = %a, expected NaN", bitcast(c.x, float), bitcast(c.y, float), r);
			continue;
		}
		assert(got == c.expected, "powf(%a, %a) = %a (%x), expected %a (%x)",
			bitcast(c.x, float), bitcast(c.y, float), r, got, bitcast(c.expected, float), c.expected);
	}
}
