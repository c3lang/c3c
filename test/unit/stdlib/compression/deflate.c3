fn void test_inflate_rejects_bad_streams()
{
	char[*] far = {
		0x03, 0x02, 0x00
	};
	char[*] block_type = {
		0x07, 0x00
	};
	char[*] stored_len = {
		0x01, 0x05, 0x00, 0x00, 0x00
	};
	assert(!@ok(deflate::decompress(mem, far[..])), "Distance before start must be rejected");
	assert(!@ok(deflate::decompress(mem, block_type[..])), "Block type 3 must be rejected");
	assert(!@ok(deflate::decompress(mem, stored_len[..])), "Bad stored length must be rejected");
}

