// #target: macos-aarch64
// #safe: yes
module test;

fn int sum(int[4] a) @export
{
	int s;
	foreach (x : a) s += x;
	return s;
}

fn void inc(int[4] a) @export
{
	foreach_r (&x : a) *x += 1;
}

fn int vsum(int[<4>] v) @export
{
	int s;
	foreach (x : v) s += x;
	return s;
}

