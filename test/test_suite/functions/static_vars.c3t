// #target: freebsd-x64
module foo;

fn int test()
{
    static int x = 1;
    tlocal int y = 2;
    x++;
    return x;
}

/* #expect: foo.ll

@foo.test.x = internal unnamed_addr global i32 1, align 4
@foo.test.y = internal thread_local(localdynamic) unnamed_addr global i32 2, align 4

define dso_local i32 @foo.test() #0 {
entry:
  %0 = call ptr @llvm.threadlocal.address.p0(ptr @foo.test.y)
  %1 = load i32, ptr @foo.test.x, align 4
  %add = add i32 %1, 1
  store i32 %add, ptr @foo.test.x, align 4
  %2 = load i32, ptr @foo.test.x, align 4
  ret i32 %2
}