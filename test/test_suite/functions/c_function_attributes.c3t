// #target: linux-x64
module fa;
extern fn void stop();

int counter @section(".fa_data") @export("fa_counter") = 3;
fn int helper(int x) @noinline @export("fa_helper") => x * 2;
fn int fast(int x) @inline @export("fa_fast") => x + 1;
fn void die() @noreturn @export("fa_die") { stop(); }
fn void placed() @section(".fa_text") @export("fa_placed") {}
fn int seven() @naked @export("fa_seven")
{
	asm
	{
		movl $eax, 7;
		ret;
	}
}

