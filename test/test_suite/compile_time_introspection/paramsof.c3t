// #target: macos-x64
module test;
import std;
fn void testme(int a, double b)
{}

fn void main()
{
	$foreach $r : $Typeof(testme)::params:
		io::printn($r.name);
		io::printn($r.type.name);
		io::printn($r.alignment);
	$endforeach
}

