// #mode: static-lib
module test;

struct Test @export
{
	int a;
	int b;
}

fn int Test.mult(self)
{
	return self.a * self.b;
}

fn int Test.hidden_mult(self) @export("__hidden_mult")
{
	return self.a * self.b;
}

