// #target: linux-x64
module i128;

bitstruct Wide : uint128
{
	ulong lo : 0..63;
	int mid : 64..95;
}

fn int128 ops(int128 a, uint128 b, int s) @export("i128_ops")
{
	int128 r = a / (int128)b + 0x1234_5678_9abc_def0_1122_3344;
	r <<= s;
	if (a < r) r = -r;
	return r % 7 + (int128)(double)b;
}

fn long wide(Wide w) @export("i128_wide") => (long)w.lo + w.mid;

fn bool[<2>] lanes(int128[<2>] a, int128[<2>] s) @export("i128_lanes") => (a << s).comp_lt(s);

