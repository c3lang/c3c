// #target: macos-x64
// #safe: yes
module test;
import std;
fn int main()
{
	char[35] x;
	long[3] w;
	long z = mem::load((long*)&x[1], 1);
	long y = ((long*)&x[1])[0];
	long ww = w[1];
	return 0;
}

/* #expect: test.ll


define i32 @main() #0 {
entry:
  %x = alloca [35 x i8], align 16
  %w = alloca [3 x i64], align 16
  %z = alloca i64, align 8
  %y = alloca i64, align 8
  %ww = alloca i64, align 8
  call void @llvm.memset.p0.i64(ptr align 16 %x, i8 0, i64 35, i1 false)
  call void @llvm.memset.p0.i64(ptr align 16 %w, i8 0, i64 24, i1 false)
  %ptradd = getelementptr inbounds i8, ptr %x, i64 1
  %ne = icmp ne ptr %ptradd, null
  br i1 %ne, label %assert_ok, label %assert_fail

assert_fail:                                      ; preds = %entry
  call void @__c3_panic(ptr @.panic_loc) #3
  unreachable

assert_ok:                                        ; preds = %entry
  %0 = load i64, ptr %ptradd, align 1
  store i64 %0, ptr %z, align 8
  %ptradd1 = getelementptr inbounds i8, ptr %x, i64 1
  %1 = ptrtoint ptr %ptradd1 to i64
  %2 = and i64 %1, 7
  %3 = icmp ne i64 %2, 0
  br i1 %3, label %panic, label %checkok

checkok:                                          ; preds = %assert_ok
  %4 = load i64, ptr %ptradd1, align 8
  store i64 %4, ptr %y, align 8
  %ptradd2 = getelementptr inbounds i8, ptr %w, i64 8
  %5 = load i64, ptr %ptradd2, align 8
  store i64 %5, ptr %ww, align 8
  ret i32 0

panic:                                            ; preds = %assert_ok
  call void @__c3_panicf.long.long(ptr @.panic_loc.3, i64 8, i64 %2) #3
  unreachable
}
