// #target: macos-aarch64
module test;

fn int a() => 0;
bitstruct Bs : int { int lo : 0..7; int hi : 8..15; }
bitstruct Ba : char[2] { int lo : 0..7; int hi : 8..15; }
bitstruct Bbe : int @bigendian { int lo : 0..7; int hi : 8..15; }

fn void init_inferred()
{
	int[<*>]? x = { unreachable(), a() };
}

fn void init_sized()
{
	int[<2>]? x = { unreachable(), a() };
}

fn void init_float()
{
	float[<3>]? x = { unreachable(), (float)a(), 1.0f };
}

fn void assign()
{
	int[<2>]? x;
	x = { unreachable(), a() };
}

fn void unreachable_last()
{
	int[<2>]? x = { a(), unreachable() };
}

fn void bitstruct_init()
{
	Bs b = { unreachable(), a() };
}

fn void bitstruct_designated()
{
	Bs b = { .lo = unreachable(), .hi = a() };
}

fn void bitstruct_optional()
{
	Bs? b = { unreachable(), a() };
}

fn void bitstruct_splat()
{
	Bs b;
	Bs c = { ...b, .lo = unreachable() };
}

fn void bitstruct_array()
{
	Ba x = { unreachable(), a() };
}

fn void bitstruct_array_designated()
{
	Ba y = { .lo = unreachable(), .hi = a() };
}

fn void bitstruct_bigendian()
{
	Bbe x = { .lo = unreachable(), .hi = a() };
}

/* #expect: test.ll

define void @test.init_inferred() #0 {
entry:
  %x = alloca <2 x i32>, align 8
  %x.f = alloca i64, align 8
  %blockret = alloca i32, align 4
  unreachable
}

define void @test.init_sized() #0 {
entry:
  %x = alloca <2 x i32>, align 8
  %x.f = alloca i64, align 8
  %blockret = alloca i32, align 4
  unreachable
}

define void @test.init_float() #0 {
entry:
  %x = alloca <3 x float>, align 16
  %x.f = alloca i64, align 8
  %blockret = alloca float, align 4
  unreachable
}

define void @test.assign() #0 {
entry:
  %x = alloca <2 x i32>, align 8
  %x.f = alloca i64, align 8
  %blockret = alloca i32, align 4
  store i64 0, ptr %x.f, align 8
  store <2 x i32> zeroinitializer, ptr %x, align 8
  unreachable
}

define void @test.unreachable_last() #0 {
entry:
  %x = alloca <2 x i32>, align 8
  %x.f = alloca i64, align 8
  %blockret = alloca i32, align 4
  %0 = call i32 @test.a()
  %1 = insertelement <2 x i32> undef, i32 %0, i64 0
  unreachable

after_macro:                                      ; No predecessors!
  %2 = insertelement <2 x i32> %1, i32 poison, i64 1
  store <2 x i32> %2, ptr %x, align 8
  store i64 0, ptr %x.f, align 8
  ret void
}

define void @test.bitstruct_init() #0 {
entry:
  %b = alloca i32, align 4
  %blockret = alloca i32, align 4
  unreachable
}

define void @test.bitstruct_designated() #0 {
