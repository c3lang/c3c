declare i32 @named(i32) #1
declare i32 @host_plain(i32) #2
define i32 @call_host(i32 %0) #3 {
define i32 @wtest__sq(i32 %0) #4 {
"wasm-import-module"="hostmod" "wasm-import-name"="get" }
"wasm-import-name"="named" }
"wasm-import-name"="host_plain" }
"wasm-export-name"="call_host" }
"wasm-export-name"="wtest__sq" }

