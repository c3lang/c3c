// #target: wasm32
module wtest;

extern fn int host_get(int x) @wasm("hostmod", "get");
extern fn int host_named(int x) @wasm("named");
extern fn int host_plain(int x);
fn int call_host(int x) @export("call_host") => host_get(x) + host_plain(x) + host_named(x);
fn int sq(int x) @export => x * x;

/* #expect: wtest.ll

