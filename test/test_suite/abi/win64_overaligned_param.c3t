// #target: windows-x64
module oa;

struct Big { float[<4>] v @align(128); int tag; }
alias BigFn = fn int(Big);

fn int consume(Big b) @export("oa_consume") => b.tag;
fn int call(Big b) @export("oa_call")
{
	BigFn f = &consume;
	return consume(b) + f(b);
}

