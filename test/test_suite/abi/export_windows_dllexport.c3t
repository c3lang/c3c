// #target: windows-x64
module wintest;

int counter @export("exported_counter");
fn int sq(int x) @export("exported_sq") => x * x;
fn int pub_fn(int x) => x + 1;
fn int use_all() @export("use_all") => sq(counter) + pub_fn(1);

