// #target: macos-aarch64
module test;
import std;
enum JumpTest		// :int  fails also
{
	ONE,
	TWO,
	THREE,
}

fn void second_test(JumpTest enu)
{
	switch (enu) @jump
	{
		case ONE..THREE: io::printn (".");
	}
}

fn void third_test(int a)
{
	switch (a) @jump
	{
		case 1..3: io::printn (".");
		case 9: io::printn ("..");
	}
}

fn void main(String[] args)
{
	JumpTest enu = TWO;
	switch (enu) @jump
	{
		case ONE: io::printn (".");
		case TWO: io::printn ("..");
		default : io::printn ("def");
	}
}

