// #target: macos-aarch64
// #safe: yes
// #opt: --infinite-loop-detect=yes
module test;

enum Color : int { RED, GREEN }
interface Greeter { fn void greet(); }
struct Thing { int a; }
faultdef BAD;
alias VoidFn = fn void();

macro void Thing.touch_macro(&self) { self.a++; }
<* @param [&in] p *>
macro int ref_macro(int* p) => *p;
<* @param [&in] p *>
fn int ref_fn(int* p) @export("ref_fn") => *p;
<* @require x > 0 *>
fn void contract_require(int x) @export("contract_require") { }
<* @require x > 0 : "x must be positive" *>
fn void contract_require_message(int x) @export("contract_require_message") { }
<* @ensure return > 0 *>
fn int contract_ensure(int x) @export("contract_ensure") => x;
<* @ensure return > 0 : "must be positive" *>
fn int contract_ensure_message(int x) @export("contract_ensure_message") => x;

fn void assert_plain(int x) @export("assert_plain") { assert(x > 0); }
fn void assert_message(int x) @export("assert_message") { assert(x > 0, "plain message"); }
fn void assert_violation() @test @export("assert_violation") { assert(false); }
fn void assert_args(int x) @export("assert_args") { assert(x > 0, "bad %d", x); }
fn void null_method(Thing* t) @export("null_method") { t.touch_macro(); }
fn void ref_arg(int* p) @export("ref_arg") { ref_macro(p); }
fn int deref(int* p) @export("deref") => *p;
fn char deref_byte(char* p) @export("deref_byte") => *p;
fn void null_function(VoidFn f) @export("null_function") { f(); }
fn void no_method(any a) @export("no_method") { Greeter g = (Greeter)a; g.greet(); }
fn int div_zero(int a, int b) @export("div_zero") => a / b;
fn int rem_zero(int a, int b) @export("rem_zero") => a % b;
fn void infinite_loop() @export("infinite_loop") { for (;;) {} }
fn void access_inner(typeid t) @export("access_inner") { (void)t.inner; }
fn void access_names(typeid t) @export("access_names") { (void)t.names; }
fn void access_len(typeid t) @export("access_len") { (void)t.len; }
fn int? fails() @export("fails") => BAD~;
fn int unwrap() @export("unwrap") => fails()!!;
fn int shift_int(int a, int b) @export("shift_int") => a << b;
fn ichar shift_ichar(ichar a, ichar b) @export("shift_ichar") => a << b;
fn uint shift_uint(uint a, uint b) @export("shift_uint") => a >> b;
fn long shift_long(long a, long b) @export("shift_long") => a << b;
fn int128 shift_int128(int128 a, int128 b) @export("shift_int128") => a << b;
fn uint128 shift_uint128(uint128 a, uint128 b) @export("shift_uint128") => a >> b;
fn int[<2>] shift_vec(int[<2>] a, int[<2>] b) @export("shift_vec") => a << b;
fn uint[<2>] shift_uvec(uint[<2>] a, uint[<2>] b) @export("shift_uvec") => a << b;
fn int index_int(int[] a, int i) @export("index_int") => a[i];
fn int index_uint(int[] a, uint i) @export("index_uint") => a[i];
fn int index_ichar(int[3]* a, ichar i) @export("index_ichar") => (*a)[i];
fn int[] slice_start(int[] a, int i) @export("slice_start") => a[i..];
fn int[] slice_range(int[] a, int i, int j) @export("slice_range") => a[i..j];
fn int[] slice_len(int[] a, int i, int j) @export("slice_len") => a[i:j];
fn void slice_copy(int[] a, int[] b) @export("slice_copy") { a[..] = b[..]; }
fn Color enum_int(int x) @export("enum_int") => (Color)x;
fn Color enum_uint(uint x) @export("enum_uint") => (Color)x;
fn Color enum_int128(int128 x) @export("enum_int128") => (Color)x;
fn Color enum_uint128(uint128 x) @export("enum_uint128") => (Color)x;
fn int main() { return 0; }

