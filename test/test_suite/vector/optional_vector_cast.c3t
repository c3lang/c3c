// #target: macos-aarch64
module foo;
import std;

fn int main()
{
	int[<4>]? x;
	int[4]? y = x;
	return 0;
}

/* #expect: foo.ll

entry:
  %x = alloca <4 x i32>, align 16
  %x.f = alloca i64, align 8
  %y = alloca [4 x i32], align 4
  %y.f = alloca i64, align 8
  store i64 0, ptr %x.f, align 8
  store <4 x i32> zeroinitializer, ptr %x, align 16
  %optval = load i64, ptr %x.f, align 8
  %not_err = icmp eq i64 %optval, 0
  br i1 %not_err, label %after_check, label %assign_optional

assign_optional:                                  ; preds = %entry
  store i64 %optval, ptr %y.f, align 8
  br label %after_assign

after_check:                                      ; preds = %entry
  %0 = load <4 x i32>, ptr %x, align 16
  %1 = extractelement <4 x i32> %0, i64 0
  %2 = insertvalue [4 x i32] undef, i32 %1, 0
  %3 = extractelement <4 x i32> %0, i64 1
  %4 = insertvalue [4 x i32] %2, i32 %3, 1
  %5 = extractelement <4 x i32> %0, i64 2
  %6 = insertvalue [4 x i32] %4, i32 %5, 2
  %7 = extractelement <4 x i32> %0, i64 3
  %8 = insertvalue [4 x i32] %6, i32 %7, 3
  store [4 x i32] %8, ptr %y, align 4
  store i64 0, ptr %y.f, align 8
  br label %after_assign

after_assign:                                     ; preds = %after_check, %assign_optional
  ret i32 0
}

