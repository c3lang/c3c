// #target: macos-aarch64
module foo;
import std;

fn int main()
{
	int[<4>]? x;
	int[4]? y = x;
	return 0;
}

/* #expect: foo.ll

entry:
  %x = alloca <4 x i32>, align 16
  %x.f = alloca i64, align 8
  %y = alloca [4 x i32], align 4
  %y.f = alloca i64, align 8
  store i64 0, ptr %x.f, align 8
  store <4 x i32> zeroinitializer, ptr %x, align 16
  %optval = load i64, ptr %x.f, align 8
  %not_err = icmp eq i64 %optval, 0
  %0 = call i1 @llvm.expect.i1(i1 %not_err, i1 true)
  br i1 %0, label %after_check, label %assign_optional

assign_optional:                                  ; preds = %entry
  store i64 %optval, ptr %y.f, align 8
  br label %after_assign

after_check:                                      ; preds = %entry
  %1 = load <4 x i32>, ptr %x, align 16
  %2 = extractelement <4 x i32> %1, i64 0
  %3 = insertvalue [4 x i32] undef, i32 %2, 0
  %4 = extractelement <4 x i32> %1, i64 1
  %5 = insertvalue [4 x i32] %3, i32 %4, 1
  %6 = extractelement <4 x i32> %1, i64 2
  %7 = insertvalue [4 x i32] %5, i32 %6, 2
  %8 = extractelement <4 x i32> %1, i64 3
  %9 = insertvalue [4 x i32] %7, i32 %8, 3
  store [4 x i32] %9, ptr %y, align 4
  store i64 0, ptr %y.f, align 8
  br label %after_assign

after_assign:                                     ; preds = %after_check, %assign_optional
  ret i32 0
}

