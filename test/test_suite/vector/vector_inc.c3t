// #target: macos-x64
module test;
fn void main()
{
    float[<1>] myvar = { 3 };
    myvar.x = ++myvar.x * 2;
}

/* #expect: test.ll

  %0 = load <1 x float>, ptr %myvar, align 4
  %1 = extractelement <1 x float> %0, i64 0
  %fincdec = fadd float %1, 1.000000e+00
  %2 = insertelement <1 x float> %0, float %fincdec, i64 0
  store <1 x float> %2, ptr %myvar, align 4
  %fmul = fmul float %fincdec, 2.000000e+00
  %3 = load <1 x float>, ptr %myvar, align 4
  %elemset = insertelement <1 x float> %3, float %fmul, i64 0
  store <1 x float> %elemset, ptr %myvar, align 4
  ret void
