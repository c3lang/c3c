// #target: macos-aarch64
module test;

// A partially designated vector literal must lower to a flat LLVM vector,
// otherwise selecting between two of them produced invalid IR.
fn float[<3>] pick(bool first)
{
	return first ? (float[<3>]){ .x = 1.0f } : (float[<3>]){ .y = 1.0f };
}

fn int main()
{
	float[<3>] a = pick(true);
	float[<3>] b = pick(false);
	assert(a[0] == 1.0f && a[1] == 0.0f && a[2] == 0.0f);
	assert(b[0] == 0.0f && b[1] == 1.0f && b[2] == 0.0f);
	return 0;
}


/* #expect: test.ll


define [3 x float] @test.pick(i8 %0) #0 {
entry:
  %1 = trunc i8 %0 to i1
  %ternary = select i1 %1, <3 x float> <float 1.000000e+00, float 0.000000e+00, float 0.000000e+00>, <3 x float> <float 0.000000e+00, float 1.000000e+00, float 0.000000e+00>
  %2 = extractelement <3 x float> %ternary, i64 0
  %3 = insertvalue [3 x float] undef, float %2, 0
  %4 = extractelement <3 x float> %ternary, i64 1
  %5 = insertvalue [3 x float] %3, float %4, 1
  %6 = extractelement <3 x float> %ternary, i64 2
  %7 = insertvalue [3 x float] %5, float %6, 2
  ret [3 x float] %7
}