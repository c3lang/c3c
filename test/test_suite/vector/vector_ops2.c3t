  br i1 %3, label %panic, label %checkok

checkok:                                          ; preds = %entry
  %sdiv = sdiv <4 x i32> %0, %1
  store <4 x i32> %sdiv, ptr %w, align 16
  %4 = load <4 x i32>, ptr %z, align 16
