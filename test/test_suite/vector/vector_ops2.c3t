  %0 = load <4 x i32>, ptr %y, align 16
  %1 = load <4 x i32>, ptr %z, align 16
  %2 = call i32 @llvm.vector.reduce.umin.v4i32(<4 x i32> %1)
  %zero = icmp eq i32 %2, 0
