// #target: macos-x64
module test;

fn void? test()
{
	int? n;
	for (n += 1; n! < 10; n += 1);
}
fn int main()
{
	(void)test();
	int? n;
	for (n += 1; n!! < 10; n += 1);
	return 0;
}

/* #expect: test.ll

define i64 @test.test() #0 {
entry:
