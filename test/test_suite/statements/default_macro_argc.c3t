// #target: linux-x64
module test;
import std, test2;

int[2] x;

macro @test2(#a = x[1])
{
	#a = 123;
}
macro test($Type = int)  { io::printn($Type::name); }

fn void testme() { io::printn("Testme"); }
macro @test3(#foo = testme()) => #foo;

fn void main()
{
	test();
	@test2();
	@test3();
	io::printn(x);
	test2::test();
	test2::@test2();
	test2::@test3();
	io::printn(test2::x);

}

