// #target: macos-x64
module test;
import std;
extern fn void puts(char* c);
alias Foo = fn void();

struct Bar
{
	Foo foo;
}

typedef Baz = Bar;

fn void Baz.foo(&self) { puts("Hello, World 2!"); }
fn int main()
{
	Baz b = { fn () { puts("Hello, World!"); } };
	b.foo();
	return 0;
}


/* #expect: test.ll

define i32 @main() #0 {
entry:
  %b = alloca %Bar, align 8
  call void @llvm.memcpy.p0.p0.i32(ptr align 8 %b, ptr align 8 @.__const, i32 8, i1 false)
  call void @test.Baz.foo(ptr %b)
  ret i32 0
}

