// #target: macos-x64
module test;
import std::io;

fn void main()
{
	@boba(;#hash_val, #foo, int $value, $Type)
	{
		io::printn("Now invoking hash");
		#hash_val;
		#hash_val;
		#foo += $value;
		io::printfn("The type was: %s", $Type::name);
	};
}

macro @unwrap(#x)
{
	io::printfn("Send %d", #x); #x++;
}
macro void @boba(;@body(#hash, #foo, $val, $Type))
{
	io::printn("Boba");
	int a = 0;
	int b = 0;
	@body(@unwrap(a), b, 3, int);
	io::printfn("%d", b);
}

