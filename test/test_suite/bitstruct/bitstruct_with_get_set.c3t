module test;
import std;
bitstruct Foo (Printable) : long
{
	int a : 2..4;
	uint b: 5..10;
}
fn sz? Foo.to_format(&self, Formatter *f) @dynamic => io::struct_to_format(*self, f, false);

fn int main()
{
	Foo d = { 1, 11 };
	d.$eval(Foo::members[0]) = 3;
	return 0;
}

