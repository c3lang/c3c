  %ptradd1 = getelementptr inbounds i8, ptr %y, i64 2
  %2 = load i16, ptr %ptradd1, align 2
  %3 = call i16 @llvm.bswap.i16(i16 %2)
  %zext = zext i8 %0 to i16
  %shl = shl i16 %zext, 8
  %4 = and i16 %shl, -256
  %5 = and i16 %3, 255
  %6 = or i16 %5, %4
  %7 = call i16 @llvm.bswap.i16(i16 %6)
  store i16 %7, ptr %ptradd1, align 2
  %ptradd2 = getelementptr inbounds i8, ptr %y, i64 2
  %8 = load i16, ptr %ptradd2, align 2
  %9 = call i16 @llvm.bswap.i16(i16 %8)
  %zext3 = zext i8 %1 to i16
  %10 = and i16 %zext3, 255
  %11 = and i16 %9, -256
  %12 = or i16 %11, %10
  %13 = call i16 @llvm.bswap.i16(i16 %12)
