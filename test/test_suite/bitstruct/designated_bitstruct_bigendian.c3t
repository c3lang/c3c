// #target: macos-aarch64
module test;

bitstruct Big : ushort @bigendian
{
	char lo : 0..7;
	char hi : 8..15;
}

bitstruct BigArr : char[2] @bigendian
{
	char lo : 0..7;
	char hi : 8..15;
}

struct Holder
{
	int k;
	Big g;
}

fn void member(char h)
{
	Holder x = { .k = 1, .g.hi = h };
}

fn void element(char h, char l)
{
	Big[2] y = { [1].hi = h, [1].lo = l };
}

fn void range(char h)
{
	Big[3] z = { [0..1].hi = h };
}

fn void array_backed(char h)
{
	BigArr[2] w = { [1].hi = h };
}

fn void main()
{
	array_backed(0x12);
	member(0x12);
	element(0x12, 0x34);
	range(0x12);
}

/* #expect: test.ll

define void @test.member(i8 zeroext %0) #0 {
entry:
  %x = alloca %Holder, align 4
  store i32 0, ptr %x, align 4
  %ptradd = getelementptr inbounds i8, ptr %x, i64 4
  store i16 0, ptr %ptradd, align 4
  store i32 1, ptr %x, align 4
  %ptradd1 = getelementptr inbounds i8, ptr %x, i64 4
  %1 = load i16, ptr %ptradd1, align 4
  %2 = call i16 @llvm.bswap.i16(i16 %1)
  %zext = zext i8 %0 to i16
  %shl = shl i16 %zext, 8
  %3 = and i16 %shl, -256
  %4 = and i16 %2, 255
  %5 = or i16 %4, %3
  %6 = call i16 @llvm.bswap.i16(i16 %5)
  store i16 %6, ptr %ptradd1, align 4
  ret void
}

define void @test.element(i8 zeroext %0, i8 zeroext %1) #0 {
entry:
