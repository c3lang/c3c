}

define void @test.array_backed(i8 zeroext %0) #0 {
entry:
  %w = alloca [2 x [2 x i8]], align 1
  store i8 0, ptr %w, align 1
  %ptradd = getelementptr inbounds i8, ptr %w, i64 1
  store i8 0, ptr %ptradd, align 1
  %ptradd1 = getelementptr inbounds i8, ptr %w, i64 2
  store i8 0, ptr %ptradd1, align 1
  %ptradd2 = getelementptr inbounds i8, ptr %ptradd1, i64 1
  store i8 0, ptr %ptradd2, align 1
  %ptradd3 = getelementptr inbounds i8, ptr %w, i64 2
  %ptradd4 = getelementptr inbounds i8, ptr %ptradd3, i64 1
