module main;
import std;

fn void test(int a @tag("hello", 1) = 3)
{}

fn int main()
{
	$assert 1 == $Typeof(&test)::params[0].get_tag("hello");
	$assert "a" == $Typeof(&test)::params[0].name;
	$assert $Typeof(&test)::params[0].type == int;
	$assert $Typeof(&test)::params[0].default_value == 3;
	return 0;
}