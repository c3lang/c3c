// #safe: yes
// #target: macos-aarch64
module test;
<* @require [a] a < 0 : "test" *>
fn int test(int x, int a)
{
	return a + a;
}

fn int main()
{
	int doekf = 1;
	test(3, doekf);
	return 0;
}

/* #expect: test.ll


define i32 @test.test(i32 %0, i32 %1) #0 {
entry:
  %lt = icmp slt i32 %1, 0
  br i1 %lt, label %assert_ok, label %assert_fail

assert_fail:                                      ; preds = %entry
  %2 = load ptr, ptr @std.core.builtin.panic, align 8
  call void %2([2 x i64] [i64 ptrtoint (ptr @.panic_msg to i64),
  unreachable

assert_ok:                                        ; preds = %entry
  %add = add i32 %1, %1
  ret i32 %add
}

define i32 @main() #0 {
entry:
  %doekf = alloca i32, align 4
  store i32 1, ptr %doekf, align 4
  %0 = load i32, ptr %doekf, align 4
  %lt = icmp slt i32 %0, 0
  br i1 %lt, label %assert_ok, label %assert_fail

assert_fail:                                      ; preds = %entry
  %1 = load ptr, ptr @std.core.builtin.panic, align 8
  call void %1([2 x i64] [i64 ptrtoint (ptr @.panic_msg to i64), i64 34],
  unreachable

assert_ok:                                        ; preds = %entry
  %2 = call i32 @test.test(i32 3, i32 %0)
  ret i32 0
}

