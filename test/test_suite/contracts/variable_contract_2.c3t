// #safe: yes
// #target: macos-aarch64
module test;
<* @require [a] a < 0 : "test" *>
fn int test(int x, int a)
{
	return a + a;
}

fn int main()
{
	int doekf = 1;
	test(3, doekf);
	return 0;
}

/* #expect: test.ll


define i32 @test.test(i32 %0, i32 %1) #0 {
entry:
  %taddr = alloca %"char[]", align 8
  %taddr1 = alloca %"char[]", align 8
  %taddr2 = alloca %"char[]", align 8
  %lt = icmp slt i32 %1, 0
  br i1 %lt, label %assert_ok, label %assert_fail

assert_fail:                                      ; preds = %entry
  store %"char[]" { ptr @.panic_msg, i64 34 }, ptr %taddr, align 8
  %2 = load [2 x i64], ptr %taddr, align 8
  store %"char[]" { ptr @.file, i64 22 }, ptr %taddr1, align 8
  %3 = load [2 x i64], ptr %taddr1, align 8
  store %"char[]" { ptr @.func, i64 4 }, ptr %taddr2, align 8
  %4 = load [2 x i64], ptr %taddr2, align 8
  %5 = load ptr, ptr @std.core.builtin.panic, align 8
  call void %5([2 x i64] %2, [2 x i64] %3, [2 x i64] %4, i32 2) #1
  unreachable

assert_ok:                                        ; preds = %entry
  %add = add i32 %1, %1
  ret i32 %add
}

define i32 @main() #0 {
entry:
  %doekf = alloca i32, align 4
  %taddr = alloca %"char[]", align 8
  %taddr1 = alloca %"char[]", align 8
  %taddr2 = alloca %"char[]", align 8
  store i32 1, ptr %doekf, align 4
  %0 = load i32, ptr %doekf, align 4
  %lt = icmp slt i32 %0, 0
  br i1 %lt, label %assert_ok, label %assert_fail

assert_fail:                                      ; preds = %entry
  store %"char[]" { ptr @.panic_msg, i64 34 }, ptr %taddr, align 8
  %1 = load [2 x i64], ptr %taddr, align 8
  store %"char[]" { ptr @.file, i64 22 }, ptr %taddr1, align 8
  %2 = load [2 x i64], ptr %taddr1, align 8
  store %"char[]" { ptr @.func.1, i64 4 }, ptr %taddr2, align 8
  %3 = load [2 x i64], ptr %taddr2, align 8
  %4 = load ptr, ptr @std.core.builtin.panic, align 8
  call void %4([2 x i64] %1, [2 x i64] %2, [2 x i64] %3, i32 11) #1
  unreachable

assert_ok:                                        ; preds = %entry
  %5 = call i32 @test.test(i32 3, i32 %0)
  ret i32 0
}

