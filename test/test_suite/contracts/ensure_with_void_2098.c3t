// #target: macos-x64
// #safe: yes
module test;

fn int main()
{
	int a;
	test(&a, 1);
	return 0;
}

<*
 @ensure *a < b
*>
fn void test(int* a, int b)
{
	*a = b + 1;
}

/* #expect: test.ll

define void @test.test(ptr %0, i32 %1) #0 {
entry:
  %add = add i32 %1, 1
  %2 = ptrtoint ptr %0 to i64
  %checknull = icmp eq i64 %2, 0
  %3 = and i64 %2, 3
  %4 = icmp ne i64 %3, 0
  %5 = or i1 %checknull, %4
  br i1 %5, label %panic, label %checkok

checkok:                                          ; preds = %entry
  store i32 %add, ptr %0, align 4
  %6 = ptrtoint ptr %0 to i64
  %checknull1 = icmp eq i64 %6, 0
  %7 = and i64 %6, 3
  %8 = icmp ne i64 %7, 0
  %9 = or i1 %checknull1, %8
  br i1 %9, label %panic2, label %checkok3

checkok3:                                         ; preds = %checkok
  %10 = load i32, ptr %0, align 4
  %lt = icmp slt i32 %10, %1
  br i1 %lt, label %assert_ok, label %assert_fail

assert_fail:                                      ; preds = %checkok3
  call void @__c3_panic(ptr @.panic_loc.3) #2
  unreachable

assert_ok:                                        ; preds = %checkok3
  ret void

panic:                                            ; preds = %entry
  call void @__c3_panic_deref(ptr @.panic_loc, i64 %2, i64 4) #2
  unreachable

panic2:                                           ; preds = %checkok
  call void @__c3_panic_deref(ptr @.panic_loc.1, i64 %6, i64 4) #2
  unreachable
}
