// #target: macos-x64
// #safe: yes
module test;
fn void main()
{
	int a = -1;
	assert(a > 0);
}

/* #expect: test.ll
@.panic_str = private unnamed_addr constant <{ i32, [24 x i8] }> <{ i32 23, [24 x i8] c"assert_default_print.c3\00" }>, align 4
@.panic_str.1 = private unnamed_addr constant <{ i32, [5 x i8] }> <{ i32 4, [5 x i8] c"main\00" }>, align 4
@.panic_str.2 = private unnamed_addr constant <{ i32, [6 x i8] }> <{ i32 5, [6 x i8] c"a > 0\00" }>, align 4

define void @test.main() #0 {
entry:
  %a = alloca i32, align 4
  store i32 -1, ptr %a, align 4
  %0 = load i32, ptr %a, align 4
  %gt = icmp sgt i32 %0, 0
  br i1 %gt, label %assert_ok, label %assert_fail

assert_fail:                                      ; preds = %entry
  call void @std.core.runtime.panics.assert(ptr @.panic_str, ptr @.panic_str.1, i32 5, ptr @.panic_str.2) #2
  unreachable

assert_ok:                                        ; preds = %entry
  ret void
}
