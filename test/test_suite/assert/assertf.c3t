// #target: macos-x64
// #safe: yes
module main;

fn void main()
{
	for (usz i = 0; i < 100000000; i++)
	{
		assert(i != 2, "Test %s %s", i, (sz)i * 2);
	}
}

/* #expect: main.ll
  %i = alloca i64, align 8
  %taddr = alloca i64, align 8
  %varargslots = alloca [2 x %any], align 16
  %panicarg = alloca %"any[]", align 8
  store i64 0, ptr %i, align 8
  br label %loop.cond

loop.cond:                                        ; preds = %assert_ok, %entry
  %0 = load i64, ptr %i, align 8
  %lt = icmp ult i64 %0, 100000000
  br i1 %lt, label %loop.body, label %loop.exit

loop.body:                                        ; preds = %loop.cond
  %1 = load i64, ptr %i, align 8
  %ne = icmp ne i64 %1, 2
  br i1 %ne, label %assert_ok, label %assert_fail

assert_fail:                                      ; preds = %loop.body
  %2 = load i64, ptr %i, align 8
  %mul = mul i64 %2, 2
  store i64 %mul, ptr %taddr, align 8
  store ptr %i, ptr %varargslots, align 16
  %ptradd = getelementptr inbounds i8, ptr %varargslots, i64 8
  store i64 ptrtoint (ptr @"$ct.ulong" to i64), ptr %ptradd, align 8
  %ptradd1 = getelementptr inbounds i8, ptr %varargslots, i64 16
  store ptr %taddr, ptr %ptradd1, align 16
  %ptradd2 = getelementptr inbounds i8, ptr %ptradd1, i64 8
  store i64 ptrtoint (ptr @"$ct.long" to i64), ptr %ptradd2, align 8
  store ptr %varargslots, ptr %panicarg, align 8
  %ptradd3 = getelementptr inbounds i8, ptr %panicarg, i64 8
  store i64 2, ptr %ptradd3, align 8
  call void @std.core.builtin.panicf(ptr @.panic_msg,
  unreachable

assert_ok:                                        ; preds = %loop.body
  %3 = load i64, ptr %i, align 8
  %add = add i64 %3, 1
  store i64 %add, ptr %i, align 8
  br label %loop.cond

loop.exit:                                        ; preds = %loop.cond

