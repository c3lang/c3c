@typeid_to_i128
  %zext = zext i64 %0 to i128
@typeid_to_u128
  %zext = zext i64 %0 to i128
@fault_to_i128
  %zext = zext i64 %0 to i128
@fault_to_u128
  %zext = zext i64 %0 to i128
@uint_to_i128
  %zext = zext i32 %0 to i128
@int_to_i128
  %sext = sext i32 %0 to i128
