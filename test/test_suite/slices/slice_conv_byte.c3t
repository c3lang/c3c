// #target: macos-x64
module test;

fn int main()
{
	char[] x = x'00aabbcc';
	bool text = x == x'00aabbcc';
	char[] $x = x'00aabbcc';
	bool $y = $x == x'00aabbcc';
    return (int)$y;
}

/* #expect: test.ll

define i32 @main() #0 {
entry:
  %x = alloca %"char[]", align 8
  %text = alloca i8, align 1
  store %"char[]" { ptr @.bytes, i64 4 }, ptr %x, align 8
  %0 = load %"char[]", ptr %x, align 8
  %1 = extractvalue %"char[]" %0, 1
  %2 = extractvalue %"char[]" %0, 0
  %eq = icmp eq i64 %1, 4
  br i1 %eq, label %slice_memcmp, label %slice_cmp_exit

slice_memcmp:                                     ; preds = %entry
  %cmp = call i32 @memcmp(ptr %2, ptr @.bytes.1, i64 %1)
  %eq1 = icmp eq i32 %cmp, 0
  br label %slice_cmp_exit

slice_cmp_exit:                                   ; preds = %slice_memcmp, %entry
  %slice_cmp_phi = phi i1 [ %eq1, %slice_memcmp ], [ false, %entry ]
  %3 = zext i1 %slice_cmp_phi to i8
  store i8 %3, ptr %text, align 1
  ret i32 1
}

declare i32 @memcmp(ptr, ptr, i64)