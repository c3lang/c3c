// #target: macos-x64
module test;
import std;
const int[4] FOO = { 1, 2, 3, 4 };
int[] y2 = FOO[1..2];

fn void test()
{
	int[][] a = { (int[]) { 1 } };
	char[4] $a = x'aabbccdd';
	var $b = $a[1..2];
	char[2] y = $b;
	assert($b == (char[]) { 187, 204 });
	assert(y == (char[2]) { 187, 204 });

}
fn int main()
{
	int[*] $x = { 1, 2, 3, 4 };
	var $y = $x[1..3];
	int[] y = { 1, 2 };
	io::printn(y.ptr);
	io::printn(y.len);
	io::printn(y);
	io::printn($y);
	int[2] $z = $y[1..2];
	io::printn($z);
	int[] $b = $y[:0];
	int[] $c = $y[:0];
	io::printn($c);
	return 0;
}

