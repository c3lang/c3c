// #target: macos-x64
// #safe: yes

module mymodule;

fn void main()
{
	int[4] array;
	int[] slice = &array;

	int[] slice1 = slice[2..5];
	int[] slice2 = slice[6..];
	int[] slice3 = slice[0..9];
	int[] slice4 = slice[5:10];
	int[] slice5 = slice[1..3];
	int[] slice6 = slice[2:10];
}

