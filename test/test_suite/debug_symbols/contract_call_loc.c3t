module test;

<*
 @require x > 0 && x < 100
*>
fn int foo(int x) => x;

fn int test(int a)
{
	int z = foo(a);
	return z;
}

macro bool @positive(x) { int tmp = x * 2; return tmp > 0; }

<*
 @require @positive(x)
*>
fn int bar(int x) => x;

fn int test2(int a)
{
	return bar(a);
}

