// #target: macos-x64
// #debuginfo: yes
module test;
faultdef NOT_FOUND;

fn int? find(int s) => s > 0 ? s : NOT_FOUND~;

fn int test(int a)
{
	int before = a;
	if (try to = find(a))
	{
		return to + before;
	}
	return 0;
}

