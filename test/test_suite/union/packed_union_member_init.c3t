  call void @llvm.memset.p0.i64(ptr align 1 %ptradd1, i8 0, i64 4, i1 false)
  store i8 1, ptr %w, align 1
  %ptradd2 = getelementptr inbounds i8, ptr %w, i64 1
  %1 = load i32, ptr @test.value, align 4
  store i32 %1, ptr %ptradd2, align 1
  store i8 0, ptr %arr, align 1
  %ptradd3 = getelementptr inbounds i8, ptr %arr, i64 1
  call void @llvm.memset.p0.i64(ptr align 1 %ptradd3, i8 0, i64 4, i1 false)
