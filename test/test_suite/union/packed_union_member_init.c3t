  store i8 0, ptr %ptradd4, align 1
  %ptradd5 = getelementptr inbounds i8, ptr %ptradd4, i64 1
  call void @llvm.memset.p0.i64(ptr align 1 %ptradd5, i8 0, i64 4, i1 false)
