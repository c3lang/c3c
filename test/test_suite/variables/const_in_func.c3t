// #target: linux-x64
module scratch;
import std::test;
fn void main()
{
	int x = test::abc();
	int* y = test::abcd();
}

module std::test;

macro abc()
{
	const int A = 256;
	return A;
}

macro abcd()
{
	const int B = 256;
	return &B;
}

/* #expect: scratch.ll

@main.B = internal constant i32 256, align 4

define void @scratch.main() #0 {
entry:
  %x = alloca i32, align 4
  %y = alloca ptr, align 8
  store i32 256, ptr %x, align 4
  store ptr @main.B, ptr %y, align 8
  ret void
}
