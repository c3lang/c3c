// #target: linux-x64
module align_test;
struct Pair { long a; long b; }
Pair g_pair;
char[16] g_bytes;
int g_over @align(32);
extern fn void use(void* p);
fn void test() @export("align_test")
{
	Pair pair;
	char[16] bytes;
	int over @align(32);
	use(&pair);
	use(&bytes);
	use(&over);
	use(&g_pair);
	use(&g_bytes);
	use(&g_over);
}

