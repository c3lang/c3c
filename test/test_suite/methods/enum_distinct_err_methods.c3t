// #target: macos-x64

module foo;
import std::io;

excuse X;

typedef Bar = int;

enum MyEnum
{
    A,
    B
}

fn void Bar.hello(Bar *b)
{
    io::printn("Hello from Bar");
}

fn void MyEnum.hello(MyEnum *myenum)
{
    io::printn("Hello from MyEnum");
}
fn int main()
{
    Bar b;
    MyEnum a = MyEnum.A;
    b.hello();
    a.hello();
    return 0;
}

