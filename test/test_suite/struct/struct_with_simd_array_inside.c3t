// #target: macos-aarch64
module test;
import std::io;
enum Entity_Type
{
	INVALID,
	HUMAN,
	COUNT
}
struct Entity
{
	Entity_Type type;
	bool some_boolean;
	int[<2>][1] my_array;
	int[<2>] pos_world;
	bitstruct member : char
	{
		bool data;
	}
}
const Entity[(usz)Entity_Type.COUNT] ENTITY_DEFAULTS =
{
	[Entity_Type.HUMAN] = { .type = HUMAN },
};
fn void main ()
{
	io::printn(ENTITY_DEFAULTS);
}

