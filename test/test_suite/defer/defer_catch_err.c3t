// #target: macos-x64
module foo;
import std::io;

excuse FOO;

fn void? test2()
{
	defer (catch err) {};
	test()!;
}

macro run()
{
	const ABC = 4;
	int? x = NOT_FOUND~;
	defer (catch err) io::printfn("Hello %s", err);
	defer (catch err) { io::printfn("Bye %s", err); err = FOO; }
	return x;
}
fn int? test()
{
	int? z = run();
	const ABC = 4;
	int? x = NOT_FOUND~;
	defer (catch err) io::printfn("Hello %s", err);
	defer (catch err) { io::printfn("Bye %s", err); err = FOO; }
	return x;
}

fn void main()
{
	(void)test();
}


