// #target: macos-aarch64
module test;
import std;

fn void print(String y)
{
	io::printn(y);
}

fn void foo(int x)
{
	print("---");
	switch FOO: (x)
	{
		case 0:
			defer print("0.0");
			switch (x)
			{
				case 0:
					defer print("0");
					nextcase FOO: 3;
			}
			print("Err");
		case 3:
			x = 3;
			defer print("3.0");
			switch (x)
			{
				case 3:
					defer print("3");
					int j = 2;
					nextcase FOO: j;
			}
			print("Err");
		case 2:
			x = 2;
			defer print("2.0");
			switch (x)
			{
				case 2:
					defer print("2");
					break FOO;
			}
			break;
	}
}
fn int main()
{
	foo(0);
	foo(2);
	return 0;
}
