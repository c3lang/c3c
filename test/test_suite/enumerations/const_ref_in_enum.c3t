// #target: macos-x64
module test;

const String STRING_NULL = (String)null[0..0];
const String FOO = STRING_NULL;
String foo = STRING_NULL;
enum Token_Type : (String symbol)
{
	INVALID {STRING_NULL},
}
fn void main ()
{
	Token_Type t = INVALID;
	foo = FOO;
}

