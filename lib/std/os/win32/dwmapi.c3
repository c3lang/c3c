module std::os::win32 @feat(WIN32) @link("dwmapi");

const DWM_BB_ENABLE = 0x00000001;
const DWM_BB_BLURREGION = 0x00000002;
const DWM_BB_TRANSITIONONMAXIMIZED = 0x00000004;

constset Win32_DWMWINDOWATTRIBUTE
{
	NCRENDERING_ENABLED,
	NCRENDERING_POLICY,
	TRANSITIONS_FORCEDISABLED,
	ALLOW_NCPAINT,
	CAPTION_BUTTON_BOUNDS,
	NONCLIENT_RTL_LAYOUT,
	FORCE_ICONIC_REPRESENTATION,
	FLIP3D_POLICY,
	EXTENDED_FRAME_BOUNDS,
	HAS_ICONIC_BITMAP,
	DISALLOW_PEEK,
	EXCLUDED_FROM_PEEK,
	CLOAK,
	CLOAKED,
	FREEZE_REPRESENTATION,
	PASSIVE_UPDATE_MODE,
	USE_HOSTBACKDROPBRUSH,
	USE_IMMERSIVE_DARK_MODE = 20,
	WINDOW_CORNER_PREFERENCE = 33,
	BORDER_COLOR,
	CAPTION_COLOR,
	TEXT_COLOR,
	VISIBLE_FRAME_BORDER_THICKNESS,
	SYSTEMBACKDROP_TYPE,
	REDIRECTIONBITMAP_ALPHA,
	BORDER_MARGINS,
}

struct Win32_DWM_BLURBEHIND
{
	Win32_DWORD dwFlags;
	Win32_BOOL  fEnable;
	Win32_HRGN  hRgnBlur;
	Win32_BOOL  fTransitionOnMaximized;
}
alias Win32_PDWM_BLURBEHIND = Win32_DWM_BLURBEHIND*;

extern fn Win32_HRESULT dwmEnableBlurBehindWindow(Win32_HWND hWnd, Win32_DWM_BLURBEHIND* pBlurBehind) @cname("DwmEnableBlurBehindWindow");
extern fn Win32_HRESULT dwmSetWindowAttribute(Win32_HWND* wnd, Win32_DWMWINDOWATTRIBUTE dwAttribute, Win32_LPCVOID pvAttribute, Win32_DWORD cbAttribute) @cname("DwmSetWindowAttribute");
extern fn Win32_HRESULT dwmGetWindowAttribute(Win32_HWND* wnd, Win32_DWMWINDOWATTRIBUTE dwAttribute, Win32_PVOID pvAttribute, Win32_DWORD cbAttribute) @cname("DwmGetWindowAttribute");