module std::os::win32 @feat(WIN32);

struct Win32_DXGI_MODE_DESC
{
	Win32_UINT                      width;
	Win32_UINT                      height;
	Win32_DXGI_RATIONAL             refreshRate;
	Win32_DXGI_FORMAT               format;
	Win32_DXGI_MODE_SCANLINE_ORDER  scanlineOrdering;
	Win32_DXGI_MODE_SCALING         scaling;
}

constset Win32_DXGI_MODE_SCANLINE_ORDER : int
{
	UNSPECIFIED       = 0x0,
	PROGRESSIVE       = 0x1,
	UPPER_FIELD_FIRST = 0x2,
	LOWER_FIELD_FIRST = 0x3,
}

constset Win32_DXGI_MODE_SCALING : int
{
	UNSPECIFIED = 0x0,
	CENTERED    = 0x1,
	STRETCHED   = 0x2,
}

